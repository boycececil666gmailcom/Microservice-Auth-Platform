# ── Go build output ───────────────────────────────────────────────────────────
bin/
*.test
coverage.out

# ── Local legacy Python artifacts ─────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]

# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── Project tooling / docs (not needed at runtime) ───────────────────────────
.qoder/
design/

# ── Environment files (secrets must never bake into the image) ───────────────
.env
.env.*
*.env

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
